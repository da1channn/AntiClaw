# =============================================================================
# AntiClaw Configuration
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# Cloudflare Access SSO
CF_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_APP_AUD=your-application-audience-tag
CF_POLICY_BYPASS=false

# Gemini CLI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-pro
GEMINI_CLI_PATH=/usr/local/bin/gemini

# Agent Configuration
MAX_CONCURRENT_AGENTS=4
AGENT_TIMEOUT_MS=300000

# Antigravity IDE (CDP Bridge)
CDP_HOST=127.0.0.1
CDP_PORT=9222
POLL_INTERVAL_MS=2000

# code-server Integration
CODE_SERVER_URL=http://127.0.0.1:8080

# Workspace (Docker mode only)
# Set to the same directory Antigravity IDE is using
WORKSPACE_PATH=/home/user/my-project

# Cloudflare Tunnel (for deployment)
CF_TUNNEL_TOKEN=your-tunnel-token

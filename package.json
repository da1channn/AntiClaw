{
  "name": "anticlaw",
  "version": "1.0.0",
  "description": "AntiClaw - Mobile-optimized gateway for Antigravity AI IDE with Cloudflare SSO",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "next dev src/client --port 3001",
    "build": "npm run build:client && npm run build:server",
    "build:client": "next build src/client",
    "build:server": "tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "uuid": "^10.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "http-proxy-middleware": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "@types/cors": "^2.8.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^10.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0"
  }
}
